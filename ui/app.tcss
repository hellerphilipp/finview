Screen {
    layers: sidebar main overlay;
}

#sidebar-container {
    dock: left;
    width: 35;
    background: $panel;
}

SidebarSection {
    height: 1fr;
}

.section-header {
    height: 1;
    text-style: bold;
    background: $panel;
    padding: 0 1;
    color: $text-muted;
}

#sidebar {
    height: 1fr;
    border-right: tall $primary;
    border-bottom: tall $primary;
}

#sidebar:focus-within {
    border-right: tall $accent;
    border-bottom: tall $accent;
}

#category-sidebar {
    height: 1fr;
    border-right: tall $primary;
}

#category-sidebar:focus-within {
    border-right: tall $accent;
}

AccountItem {
    height: 1;
    padding: 0 1;
}

AccountItem > Horizontal {
    height: 1;
}

.acc-name { width: 60%; }
.acc-bal { width: 40%; text-align: right; color: $accent; }

CategoryItem {
    height: 1;
    padding: 0 1;
}

CategoryItem > Horizontal {
    height: 1;
}

.cat-name { width: 75%; }
.cat-count { width: 25%; text-align: right; color: $accent; }

#review-banner {
    width: 1fr;
    height: 1;
    text-style: bold;
    display: none;
}

#review-banner.has-unreviewed {
    display: block;
    background: $warning;
    color: $text;
}

#review-banner.all-reviewed {
    display: block;
    background: $success;
    color: $text;
}

#main-content {
    width: 1fr;
    margin-bottom: 1;
}

#page-info {
    dock: bottom;
    width: 1fr;
    height: 1;
    text-align: right;
    color: $text;
    background: $surface;
}

#command-input {
    width: 1fr;
    display: none;
    border: none;
    padding: 0;
    height: 1;
}

#command-input.visible {
    display: block;
}

#search-input {
    width: 1fr;
    display: none;
    border: none;
    padding: 0;
    height: 1;
}

#search-input.visible {
    display: block;
}

/* Shared modal styles */
CreateAccountScreen,
ImportFileDialog,
MergeTransactionScreen,
MergeActionScreen,
CreateCategoryScreen,
DeleteCategoryConfirmScreen,
RenameCategoryScreen {
    align: center middle;
}

CreateAccountScreen #dialog,
ImportFileDialog #dialog,
CreateCategoryScreen #dialog,
DeleteCategoryConfirmScreen #dialog,
RenameCategoryScreen #dialog {
    width: 60;
    height: auto;
    background: $surface;
    border: thick $background 80%;
    padding: 0 1;
}

CreateAccountScreen #dialog Label {
    margin-top: 1;
    margin-bottom: 1;
}

CreateCategoryScreen #dialog Label,
DeleteCategoryConfirmScreen #dialog Label,
RenameCategoryScreen #dialog Label {
    margin-top: 1;
    margin-bottom: 1;
}

.hint {
    color: $text-muted;
    text-style: italic;
}

.buttons {
    width: 100%;
    padding-top: 2;
    align: center middle;
}

.buttons Button,
ImportFileDialog Button {
    margin: 0 2;
}


ImportFileDialog #dialog {
    border: thick $primary;
    padding: 1;
}
